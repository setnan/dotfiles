<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Starter Claude Code Remote Control i tmux ved innlogging. Symlinkes til
	     ~/Library/LaunchAgents av dotbot. Last inn med:
	     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.etnan.claude-rc.plist -->
	<key>Label</key>
	<string>dev.etnan.claude-rc</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>exec "$HOME/bin/claude-rc-start.sh"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/claude-rc-launchd.err</string>
</dict>
</plist>
