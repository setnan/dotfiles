#!/bin/zsh
src="${src}"
lang="${lang}"
model="${model}"
base="\${src:t:r}"
wav16="${workdir}/\${base}-16k.wav"
outbase="${HOME}/Downloads/\${base}"

/opt/homebrew/bin/ffmpeg -y -i "\${src}" -ar 16000 -ac 1 "\${wav16}"
/opt/homebrew/bin/whisper-cli -m "\${model}" -f "\${wav16}" -l "\${lang}" -otxt -of "\${outbase}"
rm -f "\${wav16}"
osascript -e "display notification \"\${base}.txt\" with title \"Transkribering ferdig (\${lang})\""
SCRIPT
chmod +x "${script_file}"

launchctl remove "${label}" 2&gt;/dev/null
launchctl submit -l "${label}" -o "${workdir}/transcribe.log" -e "${workdir}/transcribe.log" -- /bin/zsh "${script_file}"

osascript -e "display notification \"$(basename "${src}")\" with title \"Transkribering startet (no)\""
