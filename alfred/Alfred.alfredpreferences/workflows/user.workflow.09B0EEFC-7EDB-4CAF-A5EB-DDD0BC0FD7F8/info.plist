				<string>readonly pid_file="${alfred_workflow_data}/recording.pid"
readonly label_file="${alfred_workflow_data}/recording.label"
readonly log_file="${alfred_workflow_data}/ffmpeg.log"
readonly label="com.simonetnan.blackhole-recording"
mkdir -p "${alfred_workflow_data}"

if [[ -f "${pid_file}" ]] &amp;&amp; kill -0 "$(&lt; "${pid_file}")" 2&gt;/dev/null; then
  osascript -e 'display notification "Opptak pågår allerede" with title "BlackHole"'
  exit 0
fi

if /opt/homebrew/bin/SwitchAudioSource -a -t output | grep -qx "BQCE"; then
  /opt/homebrew/bin/SwitchAudioSource -s "Hodetelefoner+BlackHole"
else
  /opt/homebrew/bin/SwitchAudioSource -s "MacBook+BlackHole"
fi

sleep 0.5

readonly device_index="$(/opt/homebrew/bin/ffmpeg -f avfoundation -list_devices true -i "" 2&gt;&amp;1 | grep "BlackHole 2ch" | grep -oE '\[[0-9]+\]' | head -1 | tr -d '[]')"
readonly outfile="${HOME}/Downloads/$(date +%Y%m%d-%H%M%S).wav"

launchctl remove "${label}" 2&gt;/dev/null
launchctl submit -l "${label}" -o "${log_file}" -e "${log_file}" -- /opt/homebrew/bin/ffmpeg -f avfoundation -i ":${device_index}" -ar 44100 -y "${outfile}"

sleep 0.5
readonly pid="$(launchctl list "${label}" 2&gt;/dev/null | grep '"PID"' | grep -oE '[0-9]+')"
echo "${pid}" &gt; "${pid_file}"
echo "${label}" &gt; "${label_file}"
echo "${outfile}" &gt; "${alfred_workflow_data}/last_recording.txt"

osascript -e "display notification \"${outfile##*/}\" with title \"Opptak startet\""
