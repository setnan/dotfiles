				<string>readonly pid_file="${alfred_workflow_data}/recording.pid"
readonly label_file="${alfred_workflow_data}/recording.label"

if [[ ! -f "${pid_file}" ]] || ! kill -0 "$(&lt; "${pid_file}")" 2&gt;/dev/null; then
  osascript -e 'display notification "Ingen aktivt opptak" with title "BlackHole"'
  exit 0
fi

readonly pid="$(&lt; "${pid_file}")"
kill -INT "${pid}"

for i in {1..25}; do
  kill -0 "${pid}" 2&gt;/dev/null || break
  sleep 0.2
done

if [[ -f "${label_file}" ]]; then
  launchctl remove "$(&lt; "${label_file}")" 2&gt;/dev/null
fi

rm -f "${pid_file}" "${label_file}"

if /opt/homebrew/bin/SwitchAudioSource -a -t output | grep -qx "BQCE"; then
  /opt/homebrew/bin/SwitchAudioSource -s "BQCE"
else
  /opt/homebrew/bin/SwitchAudioSource -s "MacBook Pro-høyttalere"
fi

readonly outfile="$(&lt; "${alfred_workflow_data}/last_recording.txt" 2&gt;/dev/null)"
osascript -e "display notification \"${outfile##*/}\" with title \"Opptak lagret\""
