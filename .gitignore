*.log
*.zwc
.DS_Store

zsh/.zcompdump*
zsh/.zshrc
zsh/.zsh_history
zsh/.zsh_sessions
zsh_profile.*

# Alfred: sync folder lives in alfred/. Keep settings, snippets and workflows,
# skip machine pairings and dependency dirs inside workflows.
alfred/Alfred.alfredpreferences/remote/
alfred/Alfred.alfredpreferences/workflows/*/node_modules/
alfred/Alfred.alfredpreferences/workflows/*/.venv/

# Alfred: per-machine workflow configuration (real paths etc.) and saved window layouts
# (snapshots of window titles) stay local.
alfred/Alfred.alfredpreferences/workflows/*/prefs.plist
alfred/Alfred.alfredpreferences/workflows/user.workflow.D2F4B8A1-6C3E-4F97-8B25-1E9A7C0D4F66/layouts/
